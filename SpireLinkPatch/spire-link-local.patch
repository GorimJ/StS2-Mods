new file mode 100644
index 0000000..597b1a6
--- /dev/null
+++ b/src/BridgeExtensions.cs
@@ -0,0 +1,91 @@
+using System.Reflection;
+using MegaCrit.Sts2.Core.DevConsole;
+using MegaCrit.Sts2.Core.Nodes.Debug;
+
+namespace SpireLink;
+
+// Local additions (not upstream), 2026-11-14:
+//
+//  1. POST /v1/console runs one dev-console command exactly as if it had been typed into the game's own console.
+//     Same loopback listener and bearer key as every other route.
+//
+//  2. state.mods carries state that other mods choose to publish. A mod opts in by having a public static class
+//     named SpireLinkExport with a public static parameterless Snapshot() method that returns a dictionary of
+//     JSON-friendly values. Found by name through reflection, so neither side references the other.
+public static partial class SpireLinkMod
+{
+    private const string ExportTypeName = "SpireLinkExport";
+    private const string ExportMethodName = "Snapshot";
+
+    private static List<(string Name, MethodInfo Snapshot)>? _modExports;
+    private static DevConsole? _ownConsole;
+
+    private static List<(string Name, MethodInfo Snapshot)> FindModExports()
+    {
+        var found = new List<(string, MethodInfo)>();
+        foreach (var assembly in AppDomain.CurrentDomain.GetAssemblies())
+        {
+            if (assembly.IsDynamic || ReferenceEquals(assembly, typeof(SpireLinkMod).Assembly)) continue;
+            Type[] types;
+            try { types = assembly.GetTypes(); }
+            catch (ReflectionTypeLoadException ex) { types = ex.Types.Where(t => t != null).ToArray()!; }
+            catch { continue; }
+            foreach (var type in types)
+            {
+                if (type.Name != ExportTypeName || !type.IsAbstract || !type.IsSealed) continue; // static classes only
+                var method = type.GetMethod(ExportMethodName, BindingFlags.Public | BindingFlags.Static, Type.EmptyTypes);
+                if (method != null) found.Add((assembly.GetName().Name ?? type.FullName ?? ExportTypeName, method));
+            }
+        }
+        return found;
+    }
+
+    /// Main thread only. Null when no loaded mod publishes anything.
+    internal static Dictionary<string, object?>? CollectModState()
+    {
+        _modExports ??= FindModExports();
+        if (_modExports.Count == 0) return null;
+        var result = new Dictionary<string, object?>();
+        foreach (var (name, snapshot) in _modExports)
+        {
+            try { result[name] = snapshot.Invoke(null, null); }
+            catch (Exception ex)
+            {
+                var inner = ex is TargetInvocationException { InnerException: { } cause } ? cause : ex;
+                result[name] = new Dictionary<string, object?> { ["error"] = $"{inner.GetType().Name}: {inner.Message}" };
+            }
+        }
+        return result;
+    }
+
+    /// Main thread only.
+    internal static Dictionary<string, object?> RunConsoleCommand(string command)
+    {
+        // The game's own console, so history and the command set are the ones the player sees. It exists once the
+        // console node has been created; before that, a private instance with the same command discovery.
+        DevConsole? console = null;
+        string source = "game_console";
+        try
+        {
+            if (NDevConsole.InstanceOrNull is { } node)
+                console = typeof(NDevConsole).GetField("_devConsole", BindingFlags.Instance | BindingFlags.NonPublic)?.GetValue(node) as DevConsole;
+        }
+        catch { console = null; }
+        if (console == null)
+        {
+            console = _ownConsole ??= new DevConsole(shouldAllowDebugCommands: true);
+            source = "private_console";
+        }
+        CmdResult outcome = console.ProcessCommand(command);
+        return new Dictionary<string, object?>
+        {
+            ["status"] = outcome.success ? "ok" : "failed",
+            ["success"] = outcome.success,
+            ["message"] = outcome.msg,
+            // A command that returns a task keeps running on the game's own schedule; observe again to see its effect.
+            ["still_running"] = outcome.task is { IsCompleted: false },
+            ["console"] = source,
+            ["command"] = command
+        };
+    }
+}
